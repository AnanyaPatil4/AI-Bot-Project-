from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.metrics import mean_squared_error, r2_score

ROOT = Path(__file__).resolve().parents[1]
df = pd.read_csv(ROOT / "baseline_readings.csv")
features = ["final_x", "final_y", "final_x_velocity", "final_y_velocity",
            "final_angle", "final_angular_velocity"]
target = "total_reward"
missing = set(features + [target]) - set(df.columns)
if missing:
    raise ValueError(f"Missing columns in baseline_readings.csv: {sorted(missing)}")

X = df[features].to_numpy(dtype=float)
y = df[target].to_numpy(dtype=float)
rng = np.random.default_rng(42)
indices = rng.permutation(len(X))
split = int(0.8 * len(X))
train, test = indices[:split], indices[split:]
mu, sigma = X[train].mean(0), X[train].std(0)
sigma[sigma == 0] = 1
Xtr = (X[train] - mu) / sigma
Xte = (X[test] - mu) / sigma
Xtr = np.c_[np.ones(len(Xtr)), Xtr]
Xte = np.c_[np.ones(len(Xte)), Xte]

theta = np.zeros(Xtr.shape[1])
lr, epochs = 0.01, 5000
losses = []
for _ in range(epochs):
    error = Xtr @ theta - y[train]
    theta -= lr * (2 / len(train)) * (Xtr.T @ error)
    losses.append(np.mean(error ** 2))

pred = Xte @ theta
print("NumPy Linear Regression — random baseline reward prediction")
print(f"Test RMSE: {mean_squared_error(y[test], pred) ** 0.5:.3f}")
print(f"Test R2:   {r2_score(y[test], pred):.3f}")
pd.DataFrame({"feature": ["intercept"] + features, "coefficient": theta}).to_csv(
    ROOT / "linear_regression_coefficients.csv", index=False)
pd.DataFrame({"actual_reward": y[test], "predicted_reward": pred}).to_csv(
    ROOT / "linear_regression_predictions.csv", index=False)
plt.figure(figsize=(6, 5))
plt.scatter(y[test], pred)
lims = [min(y[test].min(), pred.min()), max(y[test].max(), pred.max())]
plt.plot(lims, lims, "k--")
plt.xlabel("Actual reward"); plt.ylabel("Predicted reward")
plt.title("NumPy Linear Regression: Actual vs Predicted")
plt.tight_layout(); plt.savefig(ROOT / "linear_regression_actual_vs_predicted.png", dpi=160)
plt.close()
plt.figure(figsize=(6, 4)); plt.plot(losses)
plt.xlabel("Epoch"); plt.ylabel("Training MSE"); plt.title("Linear Regression Loss")
plt.tight_layout(); plt.savefig(ROOT / "linear_regression_loss.png", dpi=160)
plt.close()
